// URPPT 纯软件路径追踪计算着色器
// 单 kernel PathTrace：每像素多弹射路径追踪
// BSDF: 简化金属度-粗糙度 GGX（diffuse + GGX specular, metallic workflow）
// 直接光照: NEE 遍历所有光源 + 阴影早退遍历
// 间接弹射: 按分支重要性采样（余弦半球/GGX NDF）+ 俄罗斯轮盘
//
// 关键约定（已核对 tiny_bvh_wrapper.cpp 第339-385行）:
//   - 全局 BLAS 节点的 leftFirst 已被 AssembleGlobals 预重定位:
//       内部节点 leftFirst += blasNodeBase（已是全局节点索引）
//       叶子节点   leftFirst += primIdxBase  （已是全局 primIdx 起始）
//     故 shader 侧 BLAS 遍历不再加 blasNodeBase/primIdxBase，根节点 = blasNodeBase。
//   - 全局 BLAS primIdx 值为 BLAS 内局部三角形索引，shader 侧加 triBase。
//   - 顶点索引为 BLAS 内局部索引，shader 侧加 vertBase。
//   - 实例矩阵为行主序，故用 row_major float4x4。
//   - 局部方向不归一化，使 t 参数 = 世界距离（线性变换下 t 不变）。

#pragma kernel PathTrace
#pragma kernel TemporalAccumulate
#pragma kernel SpatialFilter
#pragma kernel AntiFirefly

// ── ReSTIR GI 5-kernel 管线 ──
#pragma kernel ReSTIR_PrimaryRay
#pragma kernel ReSTIR_InitReservoir
#pragma kernel ReSTIR_TemporalResample
#pragma kernel ReSTIR_SpatialResample
#pragma kernel ReSTIR_FinalShading

#define PI 3.14159265359
#define MISS_INDEX 0xFFFFFFFFu
#define DET_EPSILON 1e-7   // Möller-Trumbore 行列式退化剔除阈值（绝对值）
#define EPS_OFFSET 5e-3

// 调试开关：=1 时画面只输出阴影可见性可视化（白=无阴影，黑=完全阴影）
#define DEBUG_SHADOW 0

// ── 与 C# 严格对齐的结构体 ──────────────────────────

// 32B，Wald 布局，直接对应 C# BVHNode32（Pack=1, 32B）
struct BVHNode
{
    float3 aabbMin;   // 0-11
    uint   leftFirst; // 12-15  内部=左子节点索引；叶子=primIdx 起始
    float3 aabbMax;   // 16-27
    uint   triCount;  // 28-31  内部=0；叶子>0
};

// 16B，对应 BLASDescriptor
struct BLASDesc
{
    uint blasNodeBase;
    uint primIdxBase;
    uint triBase;
    uint vertBase;
};

// 16B，PathTriangle 重打包（12B->16B）
struct Tri
{
    uint v0;
    uint v1;
    uint v2;
    uint _pad;
};

// 80B，PathVertex 重打包（64B->80B，HLSL 友好的 16B 对齐布局）
struct Vertex
{
    float3 pos;     float  _pad0;   // 16
    float3 normal;  float  _pad1;   // 32
    float4 tangent;               // 48
    float2 uv;      float2 _pad2;  // 64
    float4 color;               // 80
};

// 96B，材质（albedo + metallic + roughness + 纹理索引 + UV变换 + 透射参数）
struct PathMaterial
{
    float4 albedo;          // 16  - base color tint (rgb + alpha)
    float  metallic;        // 4
    float  roughness;       // 4
    float  bumpScale;       // 4   - normal map strength
    uint   flags;           // 4   - bit0:hasBase, bit1:hasMR, bit2:hasNormal, bit3:hasEmiss, bit4:isTransparent
    float4 emissionColor;   // 16  - emissive tint
    uint   baseTexID;       // 4   - BaseColorArray slice (0xFFFFFFFF=none)
    uint   metalRoughTexID; // 4   - MetallicSmoothnessArray slice
    uint   normalTexID;     // 4   - NormalArray slice
    uint   emissiveTexID;   // 4   - EmissiveArray slice
    float4 uvScaleOffset;   // 16  - xy=scale, zw=offset
    // ── 新增 16B 透射参数 ──
    float  transmission;           // 4  镜面透射因子 [0,1]，0=不透明
    float  ior;                    // 4  折射率（默认1.5玻璃，1.0空气）
    float  diffuseTransmission;    // 4  漫透射因子 [0,1]（纸张/布料等）
    uint   thinWalled;             // 4  1=薄壁（无体积衰减），0=实体
};

#define MAT_HAS_BASE       1u
#define MAT_HAS_MR         2u
#define MAT_HAS_NORMAL     4u
#define MAT_HAS_EMISS      8u
#define MAT_IS_TRANSPARENT 16u  // bit4: 材质启用透射
#define TEX_NONE       0xFFFFFFFFu

// 32B，光源
struct PathLight
{
    float3 positionOrDir; // point=世界坐标; directional=指向光源方向
    float  range;          // point=衰减范围; directional=1e34f
    float3 color;          // rgb（intensity 已乘入）
    uint   type;           // 0=point, 1=directional
};

// 144B，InstanceRecord 重打包（136B->144B）
// header.x = materialID, header.y = blasID
struct InstanceGpu
{
    uint4  header;
    row_major float4x4 transform;     // object->world
    row_major float4x4 invTransform;  // world->object
};

// 32B，光线
struct Ray
{
    float3 origin;
    float  _pad0;
    float3 direction;
    float  _pad1;
};

// 32B，命中结果
struct RayHit
{
    float t;
    float u;
    float v;
    uint  _pad0;
    uint  triIndex;  // BLAS 内局部三角形索引
    uint  instIndex; // 实例 ID（0xFFFFFFFF = 未命中）
    uint  _pad1;
    uint  _pad2;
};

// ── 输入缓冲（9 大数组 + 光源数组，由 RenderBufferManager 绑定） ──
StructuredBuffer<BVHNode>      TlasNodes;
StructuredBuffer<uint>         TlasPrimIdx;
StructuredBuffer<BVHNode>      GlobalBlasNodes;
StructuredBuffer<uint>         GlobalBlasPrimIdx;
StructuredBuffer<BLASDesc>     BlasDescriptors;
StructuredBuffer<InstanceGpu>  InstanceTable;
StructuredBuffer<Tri>          GlobalTriangles;
StructuredBuffer<Vertex>       GlobalVertices;
StructuredBuffer<PathMaterial> Materials;
StructuredBuffer<PathLight>   Lights;

// ── 全局纹理数组（由 RenderBufferManager 绑定） ──
Texture2DArray<float4> BaseColorArray;
Texture2DArray<float4> MetallicSmoothArray;
Texture2DArray<float4> NormalArray;
Texture2DArray<float4> EmissiveArray;

// 纹理采样器（与纹理同名配对）
SamplerState sampler_BaseColorArray;
SamplerState sampler_MetallicSmoothArray;
SamplerState sampler_NormalArray;
SamplerState sampler_EmissiveArray;

// ── 运行时缓冲（由渲染器绑定） ──
RWTexture2D<float4> Output;

// ── G-buffer（主光线首次命中，方案A/B共享） ──
// GBuffer0: worldPos.xyz + depth(hit.t)；miss 时 rgb=0,a=0
RWTexture2D<float4> GBufferPosDepth;
// GBuffer1: worldNormal.xyz + roughness；miss 时为 0
RWTexture2D<float4> GBufferNormalRough;

// ── 常量缓冲（由渲染器注入） ──
cbuffer PathTraceCB
{
    float4x4 CamToWorld;     // view->world
    float4x4 InvProjection; // clip->view
    uint     Width;
    uint     Height;
    float    FarPlane;
    uint     _cbPad0;
    uint     LightCount;
    uint     FrameCount;
    uint     MaxDepth;
    uint     SamplesPerPixel;  // 每像素每帧采样数（>1 时同帧多路径降噪）
    float3   AmbientColor;
    float    _cbPad2;
};

// ── 时域/空域降噪常量（由渲染器注入） ──
cbuffer TemporalCB
{
    float4x4 PrevViewProj;  // 上一帧 viewProj = prevProjection * prevView
    uint     AccumFrame;    // 静态累积帧数（相机移动时重置为0）
    uint     EnableTemporal;// 时域累积开关（0=直接用新样本）
    uint     SpatialPasses; // 空域滤波 pass 数（0=禁用）
    uint     _tcbPad0;
};

// ══════════════════════════════════════════════════════
//  NRD 移植参数（全局 uniform，由 C# SetComputeXxxParam 注入）
//  与 PassIndex 同级声明，各 kernel 按需读取
// ══════════════════════════════════════════════════════

// ── TemporalAccumulate 参数 ──
float  DisocclusionThreshold;   // 遮挡检测基础阈值（默认0.02）

// ── SpatialFilter 参数 ──
float  NormalWeightParam;       // 法线角度权重参数（默认 lerp(8,64,roughness) 基准）
float  DepthThreshold;         // 平面距离深度阈值（默认0.02）
uint   PoissonTapCount;        // Poisson 采样点数（8 或 16）
float  BlurRadius;             // 模糊半径（像素单位，默认1.0）
float  PhiLuminance;           // 亮度权重系数（默认1.0）
float  MaxLuminanceRelativeDiff;// 亮度相对差异上限（默认0.1）
uint   EnableAntiFirefly;     // anti-firefly 开关（0=关闭，1=开启）

// ── History 纹理采样器（C# 侧 filterMode=Bilinear 时生效） ──
SamplerState sampler_History;

// ══════════════════════════════════════════════════════════════
//  ReSTIR GI 蓄水池纹理声明与常量
//  4 张全屏 UAV 存储当前帧蓄水池，4 张 SRV 存储上一帧
//  D3D11 pitfall: RWTexture2D 全局声明必须绑定到每个引用 kernel
// ══════════════════════════════════════════════════════════════

// UAV: 当前帧蓄水池
RWTexture2D<float4> ReservoirRT0;  // .rgb=sampleDir(世界空间), .a=dist
RWTexture2D<float4> ReservoirRT1;  // .rg=hitNormal(八面体编码), .b=hitLuminance, .a=reserved
RWTexture2D<float4> ReservoirRT2;  // .r=w(W/M), .g=M, .b=targetPdf, .a=sourcePdf
RWTexture2D<float4> ReservoirRT3;  // .rgb=hitRadiance, .a=hitMaterialID(uint reinterpret)
RWTexture2D<float4> ReservoirRT4;  // .rgb=bsdf(K2 存储), .a=reserved

// SRV: 上一帧蓄水池（时域重采样读取历史帧）
Texture2D<float4> PrevReservoirRT0;
Texture2D<float4> PrevReservoirRT1;
Texture2D<float4> PrevReservoirRT2;
Texture2D<float4> PrevReservoirRT3;
Texture2D<float4> PrevReservoirRT4;

// SRV: 当前阶段输入蓄水池（K3 读 K2 输出，K4 读 K3 输出，K5 读 K4 输出）
Texture2D<float4> CurReservoirRT0;
Texture2D<float4> CurReservoirRT1;
Texture2D<float4> CurReservoirRT2;
Texture2D<float4> CurReservoirRT3;
Texture2D<float4> CurReservoirRT4;

// UAV: 直接光照输出（ReSTIR_PrimaryRay 写，ReSTIR_FinalShading 读）
RWTexture2D<float4> ReSTIR_DirectLighting;

// ReSTIR cbuffer 额外参数
cbuffer ReSTIRCB
{
    uint  SpatialNeighborCount;   // 空域重采样邻居数（4 或 8）
    float SpecularThreshold;      // 镜面判定阈值，roughness < 此值 → 非 ReSTIR 像素
    uint  _restirPad0;
    uint  _restirPad1;
};

