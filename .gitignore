# ====================
# IDE 生成文件
# ====================
# Visual Studio
/.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
.vsconfig

# Qoder IDE
/.qoder/

# VS Code (如需要可取消注释保留 settings.json)
#.vscode/*
#!.vscode/settings.json

# ====================
# Unity 构建产物
# ====================
*.exe
*.dll
# 保留原生路径追踪插件 DLL
!Assets/Plugins/x86_64/VulkanPathTracePlugin.dll
!Assets/Plugins/x86_64/TinyBVHNative.dll
*.apk
*.aab
*.ipa
# 备份 DLL 不提交
Assets/Plugins/x86_64/*.dll.old

# ====================
# 操作系统文件
# ====================
.DS_Store
Thumbs.db
Desktop.ini

# ====================
# NativePlugin 构建产物
# ====================
NativePlugin/build/

# ====================
# dep/tinybvh 构建产物
# （该目录是独立 git 仓库，建议作为子模块管理）
# ====================
dep/tinybvh/build-win64/
dep/tinybvh/cache/
dep/tinybvh/external/
dep/tinybvh/*.bin
dep/tinybvh/*.bvh
