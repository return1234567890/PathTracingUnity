/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# ====================
# IDE 生成文件
# ====================
# Visual Studio
/.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
.vsconfig

# Qoder IDE
/.qoder/

# VS Code
.vscode/

# ====================
# Unity 构建产物
# ====================
*.exe
*.dll
# 保留原生路径追踪插件 DLL
!Assets/Plugins/x86_64/VulkanPathTracePlugin.dll
*.apk
*.aab
*.ipa
# 备份 DLL 不提交
Assets/Plugins/x86_64/*.dll.old
Assets/Plugins/x86_64/*.bak
Assets/Plugins/x86_64/*.bak.meta
Assets/Plugins/x86_64/*.dev.bak
Assets/Plugins/x86_64/*.dev.bak.meta

# NGX 运行时日志（NVSDK 生成）
Assets/Plugins/x86_64/*.log
Assets/Plugins/x86_64/*.log.meta

# NGX 运行时 DLL 的 meta（DLL 本身被 *.dll 规则忽略，meta 孤立无意义）
Assets/Plugins/x86_64/nvngx_dlss*.dll.meta
Assets/Plugins/x86_64/nvngx_dlssd*.dll.meta
Assets/Plugins/x86_64/nvsdk_ngx*.dll.meta

# ====================
# 操作系统文件
# ====================
.DS_Store
Thumbs.db
Desktop.ini

# ====================
# NativePlugin 构建产物
# ====================
NativePlugin/build/

# 临时文件
NativePlugin/ngx_demo_temp.zip
sampleLight.diff

# ====================
# HDR 环境贴图（大文件，由 Git LFS 管理，规则见 .gitattributes）
# 不要忽略 Assets/Textures/hdr/*.hdr，否则 .meta 会变成孤立文件
# ====================
